@startuml 08-sequenz-authentifizierung-zeiteintrag
!include _sequenz-style.iuml
title Punchclock - Sequenzdiagramm: Authentifizierung bei Datenabfrage (Zeiteintrag hinzufügen)

actor Mitarbeiter
box "Browser" #F2F5FA
  participant "index.html\n(Formular)" as html
  participant "script.js" as js
end box
box "Quarkus-Backend" #EEF4FD
  participant "SmallRye JWT\n(Auth-Mechanismus)" as auth
  participant ":EntryController" as ctrl
  participant ":EntryService" as svc
  participant ":ApplicationUserRepository" as urepo
  participant ":EntryRepository" as repo
end box
database "PostgreSQL" as db

Mitarbeiter -> html : Check-in/Check-out eingeben\nund «Save» klicken
html -> js : submit-Event
activate js
js -> auth : POST /entries\nCookie: jwt=<token>  (vom Browser automatisch mitgesendet)\n{ checkIn, checkOut, categoryId, tagIds }
activate auth
auth -> auth : Token aus Cookie lesen,\nSignatur mit Public Key prüfen,\niss und exp prüfen

alt Token fehlt, ist ungültig oder abgelaufen
  auth --> js : 401 Unauthorized
  js -> html : Weiterleitung auf login.html
  html --> Mitarbeiter : Login-Formular wird angezeigt
else Token gültig
  auth -> auth : SecurityIdentity erstellen\n(upn, groups=[USER]),\n@RolesAllowed("USER") prüfen
  auth -> ctrl : create(entryDto)
  activate ctrl
  ctrl -> ctrl : userId = jwt.getSubject()
  ctrl -> svc : createEntry(entry, categoryId, tagIds, userId)
  activate svc
  note right of svc : @Transactional\n→ Transaktion startet
  svc -> urepo : findById(userId)
  activate urepo
  urepo -> db : SELECT * FROM application_user WHERE id = ?
  activate db
  db --> urepo : Benutzer
  deactivate db
  urepo --> svc : ApplicationUser
  deactivate urepo
  svc -> svc : entry.setUser(user),\nKategorie und Tags setzen
  svc -> repo : persist(entry)
  activate repo
  repo -> db : INSERT INTO entry (checkin, checkout, category_id, user_id)\nVALUES (?, ?, ?, ?)
  activate db
  db --> repo : generierte id
  deactivate db
  repo --> svc : entry.id gesetzt
  deactivate repo
  note right of svc : Transaktion wird\ncommittet
  svc --> ctrl : entry
  deactivate svc
  ctrl --> js : 200 OK\n{ id, checkIn, checkOut, category, tags }
  deactivate ctrl
  js -> js : entries.push(entry)
  js -> html : renderEntries()\nneue Tabellenzeile
  html --> Mitarbeiter : Eintrag wird in der\nTabelle angezeigt
end
deactivate auth
deactivate js
@enduml
