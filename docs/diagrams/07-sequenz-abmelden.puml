@startuml 07-sequenz-abmelden
!include _sequenz-style.iuml
title Punchclock - Sequenzdiagramm: Abmelden (Logout)

actor Mitarbeiter
box "Browser" #F2F5FA
  participant "index.html" as html
  participant "script.js" as js
  participant "Cookie-Speicher" as cookies
end box
box "Quarkus-Backend" #EEF4FD
  participant "SmallRye JWT\n(Auth-Mechanismus)" as auth
  participant ":AuthController" as ctrl
  participant ":RevokedTokenRepository" as repo
end box
database "PostgreSQL\nTabelle revoked_token" as db

Mitarbeiter -> html : «Abmelden» klicken
html -> js : click-Event
activate js
js -> auth : POST /auth/logout\nCookie: jwt=<token>
activate auth
auth -> auth : Signatur, iss und exp prüfen
auth -> ctrl : logout()  [SecurityIdentity gesetzt]
deactivate auth
activate ctrl

group optional: Token-Sperrliste (Token sofort ungültig, auch wenn kopiert)
  ctrl -> repo : persist(new RevokedToken(jti, exp))
  activate repo
  repo -> db : INSERT INTO revoked_token (jti, expires_at)\nVALUES (?, ?)
  activate db
  db --> repo : ok
  deactivate db
  repo --> ctrl : ok
  deactivate repo
end

note right of ctrl
  Ohne Sperrliste ist kein DB-Zugriff nötig:
  JWT ist zustandslos, der Server merkt sich
  keine Sitzung. Das Abmelden besteht darin,
  dass der Browser das Cookie verwirft.
end note
ctrl --> js : 204 No Content\nSet-Cookie: jwt=; HttpOnly; Secure;\nSameSite=Strict; Path=/; Max-Age=0
deactivate ctrl
js -> cookies : (Browser) Cookie «jwt» löschen
js -> js : gemerkten Benutzernamen\nund Einträge entfernen
js -> html : Weiterleitung auf login.html
deactivate js
html --> Mitarbeiter : Login-Formular wird angezeigt
@enduml
